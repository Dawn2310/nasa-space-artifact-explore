# Copy to .env (never commit .env). These are read on the SERVER only; nothing here reaches the client bundle.

# mock | anthropic | openai | gemini. "mock" needs no key and makes no network call.
LLM_PROVIDER=mock

# API key for the chosen provider. Leave empty for mock.
LLM_API_KEY=

# Optional model override. Empty = the default in server/llm.ts for the chosen provider.
LLM_MODEL=

# NASA-sourced facts are accepted by default without a separate review step.
# true additionally admits other pending facts for local demo/eval; not needed for NASA records.
ALLOW_PENDING_FACTS=false
